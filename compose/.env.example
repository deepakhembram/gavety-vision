# Docker Hub / GHCR image names (change to your namespace)
CORE_IMAGE=deepakdipu/gavety-vision-core:latest
WORKER_IMAGE=deepakdipu/gavety-ai-worker:latest
# 16+ random characters. Example: openssl rand -hex 24
GAVETY_CORE_TOKEN=
GAVETY_TOKEN=
# Where Gavety keeps its state and recordings (use the same paths on host and in containers)
STATE_DIR=/etc/gavety
HDD_ROOT=/mnt/gavety_storage
