# All optional.
CORE_IMAGE=deepakdipu/gavety-vision-core:latest
UI_PORT=5170
# Empty = open access, no login (default). Set a password to require sign-in.
GAVETY_UI_PASSWORD=
# 127.0.0.1 = only this PC can open it. Use 0.0.0.0 to allow other computers on your network.
UI_BIND=127.0.0.1
# Internal token between the web UI and the engine (never exposed); change it
GAVETY_CORE_TOKEN=change-me-internal-token-0123456789
# Where state and recordings live (a path inside the Docker host/VM)
DATA_DIR=/srv/gavety
